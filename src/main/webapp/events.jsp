<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Explore events | Campus Events</title><link rel="stylesheet" href="assets/app.css"></head><body>
<header class="topbar"><a class="wordmark" href="events"><span class="mark small">CE</span> Campus Events</a><nav><span class="hello">Hi, <c:out value="${sessionScope.name}"/></span><a class="navlink active" href="events">Explore events</a><a class="navlink" href="logout">Sign out</a></nav></header>
<main class="page"><section class="hero"><div><span class="eyebrow">YOUR CAMPUS, YOUR MOMENT</span><h1>Find your next <em>big thing.</em></h1><p>From cultural nights to ambitious hackathons, there’s something happening for everyone.</p></div><div class="hero-icon">✳</div></section>
<c:if test="${param.status == 'registered'}"><div class="notice success">You’re registered. See you at the event!</div></c:if><c:if test="${param.status == 'duplicate'}"><div class="notice error">You’re already registered for that event.</div></c:if><c:if test="${param.status == 'closed'}"><div class="notice error">Registration is closed, the event has passed, or capacity has been reached.</div></c:if>
<div class="section-heading"><div><span class="eyebrow">THE LINEUP</span><h2>Upcoming events</h2></div><span class="count"><c:out value="${events.size()}"/> events listed</span></div>
<div class="event-grid"><c:forEach items="${events}" var="e"><article class="event-card"><div class="event-top"><span class="category"><c:out value="${e.category}"/></span><span class="event-spark">✦</span></div><h3><c:out value="${e.title}"/></h3><p class="description"><c:out value="${e.description}"/></p><div class="event-meta"><span>◷ &nbsp;<fmt:formatDate value="${e.date}" pattern="EEE, dd MMM yyyy · hh:mm a"/></span><span>⌖ &nbsp;<c:out value="${e.venue}"/></span><span>♙ &nbsp;<c:out value="${e.registered}"/> registered<c:if test="${e.capacity != null}"> / <c:out value="${e.capacity}"/></c:if></span></div><div class="card-bottom"><c:choose><c:when test="${e.mine}"><button class="secondary" disabled>✓ Registered</button></c:when><c:otherwise><form method="post" action="event/register" onsubmit="return confirm('Register for this event?')"><input type="hidden" name="eventId" value="${e.id}"><button class="primary compact" type="submit">Register now <span>→</span></button></form></c:otherwise></c:choose></div></article></c:forEach></div>
<c:if test="${empty events}"><div class="empty"><div>✧</div><h3>The calendar is quiet for now</h3><p>New events will appear here when the college admin publishes them.</p></div></c:if>
<footer class="page-footer">Made for campus communities. <span>College Event Management System</span></footer></main></body></html>