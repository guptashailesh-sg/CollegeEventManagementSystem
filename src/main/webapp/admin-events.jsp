<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin dashboard | Campus Events</title><link rel="stylesheet" href="assets/app.css"></head><body>
<header class="topbar"><a class="wordmark" href="admin/events"><span class="mark small">CE</span> Campus Events <span class="admin-pill">ADMIN</span></a><nav><span class="hello">Hi, <c:out value="${sessionScope.name}"/></span><a class="navlink active" href="admin/events">Manage events</a><a class="navlink" href="logout">Sign out</a></nav></header>
<main class="page"><section class="hero admin-hero"><div><span class="eyebrow">ORGANIZER WORKSPACE</span><h1>Make things <em>happen.</em></h1><p>Create events, keep track of sign-ups, and see who’s coming.</p></div><div class="hero-icon">✳</div></section>
<c:if test="${param.status == 'created'}"><div class="notice success">Event created successfully.</div></c:if><c:if test="${param.status == 'missing'}"><div class="notice error">Please complete all required event fields.</div></c:if>
<div class="admin-layout"><section class="panel"><span class="eyebrow">NEW LISTING</span><h2>Create an event</h2><form method="post" action="events" class="stack-form"><label>Event title</label><input name="title" required maxlength="180" placeholder="e.g. Inter-college Hackathon"><label>Category</label><select name="category" required><option value="">Choose a category</option><option>Hackathon</option><option>Cultural</option><option>Fest</option><option>Sports</option><option>Workshop</option><option>Technical</option><option>Other</option></select><label>Description</label><textarea name="description" rows="4" required placeholder="What should students know?"></textarea><label>Venue</label><input name="venue" required maxlength="180" placeholder="Auditorium / Lab / Ground"><label>Event date and time</label><input type="datetime-local" name="eventDate" required><label>Registration deadline (optional)</label><input type="datetime-local" name="deadline"><label>Maximum registrations (optional)</label><input type="number" name="capacity" min="1" placeholder="Leave blank for unlimited"><button class="primary" type="submit">Publish event <span>→</span></button></form></section>
<section class="panel event-management"><div class="section-heading"><div><span class="eyebrow">OVERVIEW</span><h2>Published events</h2></div><span class="count"><c:out value="${events.size()}"/> total</span></div>
<c:forEach items="${events}" var="e"><article class="manage-row"><div class="manage-main"><span class="category"><c:out value="${e.category}"/></span><h3><c:out value="${e.title}"/></h3><p><c:out value="${e.venue}"/> · <fmt:formatDate value="${e.date}" pattern="dd MMM yyyy, hh:mm a"/></p></div><div class="manage-actions"><strong><c:out value="${e.registrations}"/></strong><small>registered</small><a href="admin/events?participants=${e.id}">View list →</a></div></article></c:forEach>
<c:if test="${empty events}"><div class="empty compact-empty"><h3>No events published yet</h3><p>Create the first event using the form.</p></div></c:if></section></div>
<c:if test="${not empty participants}"><section class="panel participant-panel"><div class="section-heading"><div><span class="eyebrow">ATTENDEE REPORT</span><h2>Registered students</h2></div><span class="count"><c:out value="${participants.size()}"/> people</span></div><div class="table-scroll"><table><thead><tr><th>Name</th><th>Email</th><th>Student ID</th><th>Department</th><th>Registered at</th></tr></thead><tbody><c:forEach items="${participants}" var="p"><tr><td><c:out value="${p.name}"/></td><td><c:out value="${p.email}"/></td><td><c:out value="${p.studentId}"/></td><td><c:out value="${p.department}"/></td><td><fmt:formatDate value="${p.registered}" pattern="dd MMM yyyy, hh:mm a"/></td></tr></c:forEach></tbody></table></div></section></c:if>
<footer class="page-footer">Admin workspace <span>College Event Management System</span></footer></main></body></html>