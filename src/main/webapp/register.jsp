<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account | Campus Events</title><link rel="stylesheet" href="assets/app.css"></head>
<body><main class="auth-wrap"><section class="brand-panel"><span class="eyebrow">JOIN THE CAMPUS</span><h1>Your next favourite memory is on the calendar.</h1><p>Create a student account to register for cultural events, hackathons, fests and more.</p><div class="bubble">✦ &nbsp; One account. Your campus events.</div></section>
<section class="auth-card"><div class="mark">CE</div><h2>Create account</h2><p class="muted">Use your college details so organizers can identify your registration.</p>
<% if (request.getAttribute("error") != null) { %><div class="notice error"><%= request.getAttribute("error") %></div><% } %>
<form method="post" action="register"><label>Full name</label><input name="name" required maxlength="120" autocomplete="name" placeholder="Your full name"><label>College email</label><input type="email" name="email" required maxlength="190" autocomplete="email" placeholder="you@college.edu"><div class="two"><div><label>Student / college ID</label><input name="studentId" required maxlength="80" placeholder="Student ID"></div><div><label>Department</label><input name="department" required maxlength="120" placeholder="Computer Engineering"></div></div><label>Password (at least 10 characters)</label><input type="password" name="password" minlength="10" required autocomplete="new-password" placeholder="Create a strong password"><button class="primary" type="submit">Create student account <span>→</span></button></form>
<p class="foot">Already registered? <a href="login.jsp">Sign in</a></p></section></main></body></html>